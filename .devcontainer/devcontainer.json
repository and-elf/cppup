{
    "name": "Alpine C++/CMake DevContainer",
    "image": "mcr.microsoft.com/vscode/devcontainers/cpp",
    "features": {},
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/sh"
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "ms-vscode.makefile-tools",
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    }
}
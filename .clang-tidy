# Calibrated to the existing codebase: strict where the style is uniform
# (types, namespaces, locals, parameters, private members) and permissive
# where the style genuinely varies across files (free functions, methods,
# a handful of public struct members).
Checks: >
  -*,
  bugprone-*,
  cert-*,
  hicpp-*,
  performance-*,
  portability-*,
  readability-*,
  modernize-*,
  cppcoreguidelines-*,
  misc-*,
  clang-analyzer-*,
  -modernize-use-trailing-return-type,
  -modernize-use-default-member-init,
  -hicpp-avoid-c-arrays,
  -hicpp-no-array-decay,
  -hicpp-signed-bitwise,
  -hicpp-uppercase-literal-suffix,
  -hicpp-vararg,
  -readability-redundant-member-init,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-do-while,
  -portability-avoid-pragma-once,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -performance-avoid-endl,
  -readability-magic-numbers,
  -readability-identifier-length
  -readability-identifier-naming
  -readability-identifier-should-be-in-braces

WarningsAsErrors: ''

# Surface implicit/narrowing conversion issues during tidy runs even when the
# normal build is not compiled with these warnings enabled.
ExtraArgs:
  - -Wconversion
  - -Wsign-conversion
  - -Wfloat-conversion
  - -Wimplicit-int-conversion
  - -Wshorten-64-to-32
  - -Wshadow
  - -Wundef
  - -Wold-style-cast
  - -Woverloaded-virtual
  - -Wnon-virtual-dtor
  - -Wformat=2

# Restrict header diagnostics to our own headers under src/ and include/.
# Anchored to the project directory (`cppup/`) so that system headers like
# `/usr/include/gtest/...` don't get analysed — they happen to end in
# `/include/` and would otherwise match a path-segment regex like
# `.*/(src|include)/`. Without this anchor, gtest macro contexts surface in
# every test file's tidy output.
HeaderFilterRegex:        '^.*/cppup/(src|include)/.*\.(hpp|h)$'
ExcludeHeaderFilterRegex: '.*/CLI/CLI11\.hpp$|.*/init_templates_data\.hpp$|.*/embedded_configuration_header\.hpp$|.*/toml\+\+/toml\.hpp$'

CheckOptions:
  # Types: uniformly CamelCase.
  - key:   readability-identifier-naming.ClassCase
    value: CamelCase
  - key:   readability-identifier-naming.StructCase
    value: CamelCase
  - key:   readability-identifier-naming.EnumCase
    value: CamelCase
  - key:   readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key:   readability-identifier-naming.TypedefCase
    value: CamelCase

  # Namespaces: uniformly lower_case.
  - key:   readability-identifier-naming.NamespaceCase
    value: lower_case

  # Locals and parameters: uniformly lower_case.
  - key:   readability-identifier-naming.VariableCase
    value: lower_case
  - key:   readability-identifier-naming.LocalVariableCase
    value: lower_case
  - key:   readability-identifier-naming.ParameterCase
    value: lower_case

  # Class members (instance or static): trailing underscore is mandatory
  # (context_, globalConfig_), but case may be snake_case_ or camelBack_ —
  # the tree mixes both (db_path_ in cli/, globalConfig_ in logger/) so we
  # accept either rather than churning existing code.
  - key:   readability-identifier-naming.PrivateMemberCase
    value: aNy_CasE
  - key:   readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key:   readability-identifier-naming.ClassMemberCase
    value: aNy_CasE
  - key:   readability-identifier-naming.ClassMemberSuffix
    value: _

  # Public struct members are mostly snake_case (header_only, build_args) but
  # a few are camelBack (projectRoot, processRunner). Accept both to avoid
  # churning the API; tighten later once those are renamed.
  - key:   readability-identifier-naming.PublicMemberCase
    value: aNy_CasE
  - key:   readability-identifier-naming.ProtectedMemberCase
    value: aNy_CasE

  # Free functions and methods mix camelBack (executeBuild, reportError) with
  # snake_case (get_shared_library_path, needs_recompilation). Same story —
  # accept both.
  - key:   readability-identifier-naming.FunctionCase
    value: aNy_CasE
  - key:   readability-identifier-naming.MethodCase
    value: aNy_CasE

  # Encourage [[nodiscard]] over legacy macros.
  - key:   modernize-use-nodiscard.ReplacementString
    value: '[[nodiscard]]'

  # Require noexcept on move/copy operators where applicable.
  - key:   modernize-use-noexcept.CheckMove
    value: 1

  # The codebase has many POD-like structs without explicit move/copy.
  - key:   cppcoreguidelines-special-member-functions.AllowMissingMove
    value: 1
  - key:   cppcoreguidelines-special-member-functions.AllowMissingCopy
    value: 1

  # Float literals are not magic.
  - key:   cppcoreguidelines-avoid-magic-numbers.IgnoreAllFloatLiterals
    value: 1

#!/usr/bin/env bash
# Pre-commit hook for cppup.
#
# Runs three checks against the staged C++ files only (fast), plus an
# optional coverage-threshold gate. If any enabled check fails the commit is
# aborted. Each of the three mandatory checks can be skipped via env var for
# the rare emergency commit:
#
#   CPPUP_SKIP_GITLEAKS=1   skip secret scan
#   CPPUP_SKIP_FORMAT=1     skip clang-format check
#   CPPUP_SKIP_TIDY=1       skip clang-tidy
#   CPPUP_SKIP_BUILD=1      skip build
#   CPPUP_SKIP_HOOKS=1      skip everything (escape hatch)
#
# The coverage gate is the opposite: OFF by default, opt in per env var.
# It reruns the whole test suite with gcov instrumentation via
# scripts/check_coverage.sh, which is too slow to force on every commit.
#
#   CPPUP_CHECK_COVERAGE=1  opt in to the coverage-threshold check below
#   CPPUP_SKIP_COVERAGE=1   skip the coverage check for one commit even if
#                           CPPUP_CHECK_COVERAGE=1 is set globally (e.g. in
#                           your shell rc)
#   CPPUP_MIN_COVERAGE=N    minimum total line-coverage percentage required
#                           (default: 70; see scripts/check_coverage.sh)
#
# Install once per clone: scripts/setup-hooks.sh

set -euo pipefail

if [[ "${CPPUP_SKIP_HOOKS:-0}" == "1" ]]; then
    echo "[pre-commit] CPPUP_SKIP_HOOKS=1, skipping all checks."
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Resolve the cppup binary: prefer one on PATH, fall back to bootstrap_build,
# then build/. If none exists we skip the cppup-driven checks rather than
# fail — the developer may not have built yet.
cppup_bin=""
if command -v cppup >/dev/null 2>&1; then
    cppup_bin="$(command -v cppup)"
elif [[ -x "$repo_root/bootstrap_build/cppup" ]]; then
    cppup_bin="$repo_root/bootstrap_build/cppup"
elif [[ -x "$repo_root/build/cppup" ]]; then
    cppup_bin="$repo_root/build/cppup"
fi

# Collect staged C++ files (added/copied/modified/renamed). Exclude deletions.
mapfile -t staged < <(
    git diff --cached --name-only --diff-filter=ACMR -- \
        '*.cpp' '*.cxx' '*.cc' '*.c' '*.hpp' '*.hxx' '*.h'
)

# 1. gitleaks — runs whether or not staged C++ exists; secrets can hide anywhere.
if [[ "${CPPUP_SKIP_GITLEAKS:-0}" != "1" ]]; then
    if command -v gitleaks >/dev/null 2>&1; then
        echo "[pre-commit] gitleaks (staged)…"
        if ! gitleaks protect --staged --redact --no-banner; then
            echo "[pre-commit] gitleaks found potential secrets — aborting."
            echo "             Set CPPUP_SKIP_GITLEAKS=1 to override (don't, normally)."
            exit 1
        fi
    else
        echo "[pre-commit] gitleaks not installed — skipping. Install from"
        echo "             https://github.com/gitleaks/gitleaks to enable."
    fi
fi

if [[ ${CPPUP_SKIP_BUILD:-0} != "1" ]]; then
    echo "[pre-commit] Building cppup (required for format/tidy checks)…"
    if ! ./bootstrap.sh build >/dev/null; then
        echo "[pre-commit] failed to build cppup — skipping format/tidy checks."
        echo "             Fix build issues or set CPPUP_SKIP_BUILD=1 to override."
        exit 1
    fi
fi

# Short-circuit cppup checks if nothing C++ changed.
if [[ ${#staged[@]} -eq 0 ]]; then
    echo "[pre-commit] No staged C++ files; skipping format/tidy."
    exit 0
fi

if [[ -z "$cppup_bin" ]]; then
    echo "[pre-commit] cppup binary not found (looked in PATH, bootstrap_build/, build/)."
    echo "             Skipping format/tidy. Run ./bootstrap.sh build to enable."
    exit 1
fi

# 2. cppup format --check on staged files only.
if [[ "${CPPUP_SKIP_FORMAT:-0}" != "1" ]]; then
    echo "[pre-commit] cppup format --check (${#staged[@]} file(s))…"
    if ! "$cppup_bin" format --check "${staged[@]}"; then
        echo "[pre-commit] formatting issues — run \`cppup format ${staged[*]}\` to fix."
        exit 1
    fi
fi

# 3. cppup tidy on staged files only. Requires compile_commands.json.
# Test files (tests/ subdirs or test_*.cpp / *_test.cpp basenames) are
# skipped inside `cppup tidy` itself, so this hook just forwards.
if [[ "${CPPUP_SKIP_TIDY:-0}" != "1" ]]; then
    if [[ ! -f "$repo_root/compile_commands.json" ]]; then
        echo "[pre-commit] compile_commands.json missing — skipping tidy."
        echo "             Run \`cppup compile-commands\` to enable."
    else
        echo "[pre-commit] cppup tidy (${#staged[@]} staged file(s))…"
        if ! "$cppup_bin" tidy "${staged[@]}"; then
            echo "[pre-commit] clang-tidy reported issues — fix or set CPPUP_SKIP_TIDY=1."
            exit 1
        fi
    fi
fi

# 4. Coverage threshold — OFF by default (see header). Opt in with
#    CPPUP_CHECK_COVERAGE=1; it rebuilds the suite with instrumentation and
#    reruns everything, so this is deliberately not part of the fast path.
if [[ "${CPPUP_CHECK_COVERAGE:-0}" == "1" && "${CPPUP_SKIP_COVERAGE:-0}" != "1" ]]; then
    echo "[pre-commit] cppup test --coverage (CPPUP_CHECK_COVERAGE=1)…"
    if ! CPPUP_COVERAGE_BIN="$cppup_bin" "$repo_root/scripts/check_coverage.sh"; then
        echo "[pre-commit] coverage check failed — fix coverage or set CPPUP_SKIP_COVERAGE=1."
        exit 1
    fi
fi

exit 0
